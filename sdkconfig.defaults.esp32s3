CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_MHZ=240
# CONFIG_ESP32S3_INSTRUCTION_CACHE_16KB is not set
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_SIZE=0x8000

CONFIG_ESP32_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP32_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP32_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP32_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP32_WIFI_TX_BA_WIN=32
CONFIG_ESP32_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP32_WIFI_RX_BA_WIN=32

CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64

CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_LINE_32B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_WRAP=y

# --- Flash size: 16MB, and do NOT let esptool re-detect ----------------------
# YD-ESP32-S3 (ESP32-S3-WROOM-1-N16R8) carries a 16MB flash. Kconfig's default
# is 2MB (an ESP8266-era number), so leaving it alone used to put flash_size=2MB
# into the bootloader image header.
#
# Why that produced a scary line at every boot:
#   The bootloader image ends with a SHA-256 over its own body, and that digest
#   covers the header. With CONFIG_ESPTOOLPY_FLASHSIZE_DETECT=y, esptool probes
#   the real chip (16MB), rewrites header byte 3 (0x1f -> 0x4f) right before
#   writing -- and never recomputes the appended digest. So flash then held an
#   image whose body hashed to something the trailing 32 bytes did not describe,
#   and the ROM printed:
#       SHA-256 comparison failed: Calculated ... Expected ... Attempting to boot anyway...
#   Nothing was broken; the image still booted. But the integrity check was
#   permanently useless, and the log lied about it on every single boot.
#
# Declaring the real size makes the header already correct, so esptool's patch
# becomes a no-op and the digest keeps matching.
# If you port this to a board with different flash (e.g. N8R8 = 8MB), change
# this value -- leaving DETECT off is deliberate: detection silently rewrites a
# hashed header instead of failing loudly.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
# CONFIG_ESPTOOLPY_FLASHSIZE_DETECT is not set

# --- Productization P1: console primary channel -> USB-Serial/JTAG -----------
# IDF's "secondary console" mode is output-only and accepts no input
# (esp_system/Kconfig: "only supports non-blocking mode without using REPL";
#  input requires switching the PRIMARY channel to this port). This project
#  needs COM18 full-duplex for the @command channel:
#    primary   = USB-Serial/JTAG (GPIO19/20, onboard native USB)
#    secondary = NONE            (mutually exclusive with the line above)
# Cost: UART0 (GPIO43/44) no longer carries logs. The UART bridge uses
#       UART1 (GPIO17/18) and is unaffected.
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- Offline flashing (0.9.0): custom partition table ------------------------
# 16MB layout, see partitions.csv at the repo root:
#   nvs/phy_init keep their singleapp offsets (upgrade keeps credentials),
#   factory 1.5MB, otadata + ota_0/ota_1 (1.5MB each, reserved for the
#   future OTA line), storage 11MB for flash images (LittleFS).
# S3-only on purpose: the esp8266/c3 variants have far less flash and keep
# their stock single-app tables.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
