/**
 * @file wifi_credentials.h.example
 * @brief 本地私有 WiFi 凭据模板
 *
 * 用法:
 *   1. 复制本文件为同目录下的 wifi_credentials.h
 *   2. 把 ssid/password 换成你自己的 WiFi
 *   3. wifi_credentials.h 已被 .gitignore 排除,不会提交
 *
 * 若不创建 wifi_credentials.h,固件会使用 wifi_configuration.h 里的
 * 出厂默认列表(DAP / OTA,密码 12345678),用于首次配网前的启动。
 */
#ifndef __WIFI_CREDENTIALS__
#define __WIFI_CREDENTIALS__

static struct {
    const char *ssid;
    const char *password;
} wifi_list[] __attribute__((unused)) = {
    // 按顺序尝试,靠前的优先。最多建议 5 条。
    {.ssid = "your-ssid", .password = "your-password"},
};

#define WIFI_LIST_SIZE (sizeof(wifi_list) / sizeof(wifi_list[0]))

#endif
